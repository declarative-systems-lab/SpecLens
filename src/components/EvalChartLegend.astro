---
interface Props {
  variant: 'userstudy' | 'sus' | 'benchmark-line' | 'benchmark-time';
}

const { variant } = Astro.props;
---

<div class="eval-legend">
  {
    variant === 'userstudy' && (
      <>
        <span class="eval-legend__item"><span class="eval-legend__swatch eval-legend__swatch--control" aria-hidden="true"></span><span data-i18n="legend.withoutSubspecs">Without SubSpec</span></span>
        <span class="eval-legend__item"><span class="eval-legend__swatch eval-legend__swatch--experimental" aria-hidden="true"></span><span data-i18n="legend.withSubspecs">With SubSpec</span></span>
        <span class="eval-legend__item"><span class="eval-legend__line" aria-hidden="true"></span><span data-i18n="legend.median">Median</span></span>
        <span class="eval-legend__item"><span class="eval-legend__line eval-legend__line--mean" aria-hidden="true"></span><span data-i18n="legend.mean">Mean Value</span></span>
      </>
    )
  }
  {
    variant === 'sus' && (
      <>
        <span class="eval-legend__item"><span class="eval-legend__swatch eval-legend__swatch--positive" aria-hidden="true"></span><span data-i18n="legend.positive">Positive</span></span>
        <span class="eval-legend__item"><span class="eval-legend__swatch eval-legend__swatch--negative" aria-hidden="true"></span><span data-i18n="legend.negative">Negative</span></span>
        <span class="eval-legend__item"><span class="eval-legend__line" aria-hidden="true"></span><span data-i18n="legend.median">Median</span></span>
        <span class="eval-legend__item"><span class="eval-legend__line eval-legend__line--mean" aria-hidden="true"></span><span data-i18n="legend.mean">Mean Value</span></span>
      </>
    )
  }
  {
    variant === 'benchmark-line' && (
      <>
        <span class="eval-legend__item"><span class="eval-legend__series eval-legend__series--fullsym" aria-hidden="true"><span class="eval-legend__marker eval-legend__marker--square"></span></span><span data-i18n="legend.fullSym">FullSym</span></span>
        <span class="eval-legend__item"><span class="eval-legend__series eval-legend__series--subspec-ns" aria-hidden="true"><span class="eval-legend__marker eval-legend__marker--triangle"></span></span><span class="eval-legend__label">SubSpec<sub>NS</sub></span></span>
        <span class="eval-legend__item"><span class="eval-legend__series eval-legend__series--subspec" aria-hidden="true"><span class="eval-legend__marker eval-legend__marker--circle"></span></span><span data-i18n="legend.subspec">SubSpec</span></span>
        <span class="eval-legend__item"><span class="eval-legend__line eval-legend__line--timeout" aria-hidden="true"></span><span data-i18n="legend.timeout">Timeout</span></span>
      </>
    )
  }
  {
    variant === 'benchmark-time' && (
      <>
        <span class="eval-legend__item"><span class="eval-legend__swatch eval-legend__swatch--fullsym" aria-hidden="true"></span><span data-i18n="legend.fullSym">FullSym</span></span>
        <span class="eval-legend__item"><span class="eval-legend__swatch eval-legend__swatch--subspec-ns" aria-hidden="true"></span><span class="eval-legend__label">SubSpec<sub>NS</sub></span></span>
        <span class="eval-legend__item"><span class="eval-legend__swatch eval-legend__swatch--subspec" aria-hidden="true"></span><span data-i18n="legend.subspec">SubSpec</span></span>
      </>
    )
  }
</div>
