---
import { siteMeta, contact } from '../../config/siteContent';
---

<footer class="site-footer">
  <div class="container">
    <p class="site-footer__contact">
      <span data-i18n="hero.contactLabel">Contact:</span>
      <a href={`mailto:${contact.email}`}>{contact.email}</a>
      · <span data-i18n="home.affiliation">{contact.affiliation}</span>
    </p>
    <p class="site-footer__meta">© {new Date().getFullYear()} {siteMeta.name}</p>
  </div>
</footer>
