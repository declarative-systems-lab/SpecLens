---
import { assetUrl } from '../../utils/assetUrl';

const userStudyUrl = assetUrl('/userstudy/index.html');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0; url=${userStudyUrl}`} />
    <link rel="canonical" href={userStudyUrl} />
    <title>User Study</title>
  </head>
  <body>
    <p>
      Redirecting to the user study.
      <a href={userStudyUrl}>Open it here</a>.
    </p>
  </body>
</html>
